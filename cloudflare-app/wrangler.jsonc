{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flowx-app",
  "account_id": "a828bebda1f352216c7d7da425bad17a",
  "main": "worker.js",
  "compatibility_date": "2026-07-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flowx-cloud-db",
      "database_id": "dc5bc99b-bac3-4fc7-b51c-ba9b43c465ec"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": { "enabled": true }
}
