# FlowX 环境变量模板
# 用法：cp .env.example .env  然后在等号后面填上你自己的值（不要加引号）
# .env 已在 .gitignore 里，不会进版本库/交接包；key 填一次，后续更新代码不会覆盖它。

# ========== 必填 ==========
# DeepSeek：出文 + AI 质检 + 一键优化都靠它，不填整条链跑不起来
DEEPSEEK_API_KEY=
# Tavily：搜索素材（免费额度，每月 1000 次），搜索兜底链的第一优先
TAVILY_API_KEY=

# ========== 选填（不填则对应功能降级，不影响主流程） ==========
# 博查：搜索兜底链的第二级（付费，内容更全）。不填则 Tavily 不达标时无处回退
BOCHA_API_KEY=
# Pexels：配图兜底图库（抓不到报道原图 / 换图候选用尽时用）。不填则无图库兜底
PEXELS_API_KEY=

# ========== 自动发布（走 Wechatsync 浏览器扩展 + CLI）==========
# Wechatsync CLI 的 token（自动发布 /sync、自动流水线发草稿时传给 CLI）
WECHATSYNC_TOKEN=
# Wechatsync CLI 的绝对路径。留空则用代码内默认（nvm 装的 wechatsync）；
# 换机器/换 node 版本后路径不同，在这里覆盖即可
WECHATSYNC_CLI_PATH=

# ========== 高级/可选 ==========
# 本服务对外可访问地址（CLI/扩展抓正文里的图片要用）。留空默认 http://127.0.0.1:8000
FLOWX_BASE_URL=
# 头条发布器 dry-run 开关：设为 1 时走到人工确认闸前停住、不真提交（仅测试用）
TOUTIAO_DRY_RUN=
